{
  "id_patterns": {
    "component_id": "^PCC-C[0-9]{2}$",
    "claim_id": "^CLM-[0-9]{4}$",
    "source_id": "^SRC-[0-9]{4}$",
    "novelty_id": "^NOV-[0-9]{4}$",
    "search_id": "^SEA-[0-9]{4}$",
    "decision_id": "^DEC-[0-9]{4}$",
    "import_id": "^IMP-[0-9]{4}$",
    "claim_source_link_id": "^CE-[0-9]{4}$",
    "claim_decision_link_id": "^CD-[0-9]{4}$",
    "component_provenance_id": "^CP-[0-9]{4}$",
    "novelty_source_link_id": "^NS-[0-9]{4}$"
  },
  "registers": {
    "data/components.csv": {
      "id_column": "component_id",
      "id_pattern": "component_id",
      "required_columns": [
        "component_id",
        "name",
        "definition",
        "status",
        "decision_id"
      ]
    },
    "data/claims.csv": {
      "id_column": "claim_id",
      "id_pattern": "claim_id",
      "required_columns": [
        "claim_id",
        "claim_text",
        "claim_type",
        "claim_strength",
        "status",
        "proposal_location",
        "components",
        "pcc_relation",
        "implication_for_pcc",
        "novelty_risk",
        "origin",
        "last_reviewed"
      ]
    },
    "data/sources.csv": {
      "id_column": "source_id",
      "id_pattern": "source_id",
      "required_columns": [
        "source_id",
        "elicit_key",
        "zotero_key",
        "title",
        "authors",
        "year",
        "doi",
        "url",
        "source_type",
        "metadata_authority",
        "verification_status",
        "retrieval_status",
        "notes"
      ]
    },
    "data/claim_source_links.csv": {
      "id_column": "link_id",
      "id_pattern": "claim_source_link_id",
      "required_columns": [
        "link_id",
        "claim_id",
        "source_id",
        "evidence_relation",
        "provenance_relation",
        "locator",
        "verification_status",
        "notes"
      ]
    },
    "data/claim_decision_links.csv": {
      "id_column": "link_id",
      "id_pattern": "claim_decision_link_id",
      "required_columns": [
        "link_id",
        "claim_id",
        "decision_id",
        "relation",
        "notes"
      ]
    },
    "data/component_provenance.csv": {
      "id_column": "provenance_id",
      "id_pattern": "component_provenance_id",
      "required_columns": [
        "provenance_id",
        "component_id",
        "source_id",
        "prior_work_contribution",
        "pcc_adopts",
        "pcc_changes",
        "pcc_extends",
        "provenance_relation",
        "evidence_locator",
        "verification_status"
      ]
    },
    "data/novelty_propositions.csv": {
      "id_column": "novelty_id",
      "id_pattern": "novelty_id",
      "required_columns": [
        "novelty_id",
        "novelty_type",
        "proposed_delta",
        "components_combined",
        "current_wording",
        "audit_status",
        "residual_difference",
        "searches_completed",
        "last_reviewed",
        "notes"
      ]
    },
    "data/novelty_source_links.csv": {
      "id_column": "link_id",
      "id_pattern": "novelty_source_link_id",
      "required_columns": [
        "link_id",
        "novelty_id",
        "source_id",
        "threat_role",
        "what_source_covers",
        "unlocated_or_missing_link",
        "verification_status"
      ]
    },
    "data/searches.csv": {
      "id_column": "search_id",
      "id_pattern": "search_id",
      "required_columns": [
        "search_id",
        "date",
        "search_type",
        "query",
        "scope",
        "source_system",
        "status",
        "result_count",
        "notes"
      ]
    },
    "data/decisions.csv": {
      "id_column": "decision_id",
      "id_pattern": "decision_id",
      "required_columns": [
        "decision_id",
        "date",
        "decision",
        "rationale",
        "participants",
        "affected_claims",
        "affected_sections",
        "supersedes",
        "status",
        "authority_level"
      ]
    },
    "imports/manifest.csv": {
      "id_column": "import_id",
      "id_pattern": "import_id",
      "required_columns": [
        "import_id",
        "original_filename",
        "stored_path",
        "sha256",
        "size_bytes",
        "media_type",
        "duplicate_of",
        "import_status",
        "authority_role",
        "notes"
      ]
    }
  }
}
