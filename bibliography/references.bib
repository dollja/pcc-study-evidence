@inproceedings{kambhampati_synthesizing_2019,
	address = {New York, New York},
	title = {Synthesizing {Explainable} {Behavior} for {Human}-{AI} {Collaboration}},
	url = {https://dl.acm.org/doi/10.5555/3306127.3331663},
	doi = {10.65109/ZAOX1509},
	abstract = {As AI technologies enter our everyday lives at an ever increasing pace, there is a greater need for AI systems to work synergistically with humans. This requires AI systems to exhibit behavior that is explainable to humans. Synthesizing such behavior requires AI systems to reason not only with their own models of the task at hand, but also about the mental models of the human collaborators. Using several case-studies from our ongoing research, I will discuss how such multi-model planning forms the basis for explainable behavior.},
	urldate = {2026-07-27},
	author = {Kambhampati, Subbarao},
	month = may,
	year = {2019},
	pages = {1--2},
}

